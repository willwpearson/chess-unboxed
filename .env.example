# Environment template
# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://pyncrtqwvkadrlqpdklx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Secret for user sessions
JWT_SECRET=your_jwt_secret_key_here

# Postgres connection string for Drizzle migrations (db:generate/db:migrate/db:studio).
# Use the Supabase project's connection string (Settings > Database > Connection string).
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Resend (https://resend.com) — email delivery for password reset. Free tier
# (3,000/month, 100/day) is enough for this app's volume; no paid provider needed.
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com

# Base URL used to build links in outgoing emails (e.g. password reset).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# Set to true in .env.local to run auth fully offline (in-memory, no Supabase calls).
# Seeds a fixed login: username "devuser", password "devpassword". See docs/CONTEXT.md.
NEXT_PUBLIC_DEV_MODE=false
